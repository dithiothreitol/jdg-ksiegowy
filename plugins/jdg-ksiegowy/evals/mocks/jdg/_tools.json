          },
          "document_number": {
            "description": "Numer faktury sprzedawcy.",
            "title": "Document Number",
            "type": "string"
          },
          "issue_date": {
            "format": "date",
            "title": "Issue Date",
            "type": "string"
          },
          "net": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Net"
          },
          "vat": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Kwota VAT.",
            "title": "Vat"
          },
          "vat_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "default": "23",
            "title": "Vat Rate"
          },
          "receive_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Data wpływu — okres odliczenia.",
            "title": "Receive Date"
          },
          "seller_country": {
            "default": "PL",
            "title": "Seller Country",
            "type": "string"
          },
          "description": {
            "default": "",
            "title": "Description",
            "type": "string"
          },
          "category": {
            "$ref": "#/$defs/ExpenseCategory",
