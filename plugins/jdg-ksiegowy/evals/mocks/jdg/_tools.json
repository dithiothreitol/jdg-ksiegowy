            "default": "100",
            "title": "Vat Deduction Pct"
          },
          "reverse_charge": {
            "default": false,
            "description": "Import usług: VAT należny i naliczony po stronie nabywcy.",
            "title": "Reverse Charge",
            "type": "boolean"
          },
          "file_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Dowód (PDF/JPG/XML).",
            "title": "File Path"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Notes"
